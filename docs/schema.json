    "/promotions/api/v1/staff/promotions/": {
      "get": {
        "operationId": "promotions_staff_promotions_list",
        "description": "Renders a service refusal as the fleet error envelope.\n\n**Permissions:** `IsStaffUser`",
        "parameters": [
          {
            "in": "query",
            "name": "active",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "anchor",
            "schema": {
              "type": "string"
            },
            "description": "Opaque anchor from next_anchor/prev_anchor (exclusive)."
          },
          {
            "in": "query",
            "name": "direction",
            "schema": {
              "type": "string",
              "enum": [
                "next",
                "prev"
              ]
            },
            "description": "Walk direction from the anchor."
          },
          {
            "in": "query",
            "name": "kind",
            "schema": {
              "type": "string",
              "enum": [
                "fixed",
                "free_shipping",
                "percent"
              ]
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            },
            "description": "Page size, default 50, max 200."
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "description": "Name, key or an exact code."
          }
        ],
        "tags": [
          "Promotions"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromotionPage"
                }
              }
            },
            "description": ""
          }
        }
      },
      "post": {
        "operationId": "promotions_staff_promotions_create",
        "description": "Renders a service refusal as the fleet error envelope.\n\n**Permissions:** `IsStaffUser`",
        "tags": [
          "Promotions"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromotionWriteRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PromotionWriteRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PromotionWriteRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromotionResponse"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
