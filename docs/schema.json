            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CodeValidateRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CodeValidateRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "JWTCookieAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeValidateResponse"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
