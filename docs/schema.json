          "Promotions"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivePromotionList"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/promotions/api/v1/codes/validate/": {
      "post": {
        "operationId": "promotions_codes_validate",
        "description": "Would this code apply? The real discount comes from the orders quote.\n\n**Permissions:** `AllowAny`",
