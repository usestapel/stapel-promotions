  "components": {
    "schemas": {
      "ActivePromotionList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicPromotion"
            }
          },
          "truncated": {
            "type": "boolean",
            "description": "More promotions are live than ACTIVE_LIST_LIMIT."
          }
        },
        "required": [
          "items",
          "truncated"
        ]
      },
      "CodeGenerateRequest": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "description": "At most GENERATE_MAX_PER_CALL."
          },
          "prefix": {
            "type": "string",
            "maxLength": 16
          },
          "length": {
            "type": "integer",
            "maximum": 32,
            "minimum": 6
          },
          "usage_limit": {
            "type": "integer",
            "maximum": 10000000,
            "minimum": 1,
            "nullable": true
          }
        },
        "required": [
          "count"
        ]
      },
      "CodeGenerateResponse": {
        "type": "object",
        "properties": {
          "batch": {
            "type": "string",
            "maxLength": 32
          },
          "created": {
            "type": "integer",
            "minimum": 0
          },
          "codes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "required": [
          "batch",
          "codes",
          "created"
        ]
      },
      "CodeValidateRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 128
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "pattern": "^[A-Za-z]{3}$"
          },
          "subtotal": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,16}(?:\\.\\d{0,2})?$",
            "description": "Cart subtotal, for the minimum-amount rule."
          }
        },
        "required": [
          "code"
        ]
      },
      "CodeValidateResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The code, normalised.",
            "maxLength": 128
          },
          "valid": {
            "type": "boolean"
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "Error key when not valid.",
            "maxLength": 128
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 128
            }
          },
          "promotion": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicPromotion"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "code",
          "error",
          "params",
          "promotion",
          "valid"
        ]
      },
      "PatchedPromoCodeUpdateRequest": {
        "type": "object",
        "properties": {
          "is_active": {
            "type": "boolean"
          },
          "usage_limit": {
            "type": "integer",
            "maximum": 10000000,
            "minimum": 1,
            "nullable": true
          }
        }
      },
      "PatchedPromotionWriteRequest": {
        "type": "object",
        "properties": {
          "key": {
            "description": "Generated from the name when blank.",
            "oneOf": [
              {
                "type": "string",
                "maxLength": 58,
                "pattern": "^[-a-zA-Z0-9_]+$"
              },
              {
                "type": "string",
                "maxLength": 0
              }
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "kind": {
            "$ref": "#/components/schemas/PromotionKindEnum"
          },
          "value": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,10}(?:\\.\\d{0,2})?$"
          },
          "currency": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 3,
                "pattern": "^[A-Za-z]{3}$"
              },
              {
                "type": "string",
                "maxLength": 0
              }
            ]
          },
          "max_discount": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,10}(?:\\.\\d{0,2})?$",
            "nullable": true
          },
          "min_subtotal": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,10}(?:\\.\\d{0,2})?$",
            "nullable": true
          },
          "scope": {
            "$ref": "#/components/schemas/PromotionScopeEnum"
          },
          "scope_type": {
            "type": "string",
            "maxLength": 32
          },
          "scope_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 255
            },
            "maxItems": 500
          },
          "free_shipping_methods": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32
            },
            "description": "free_shipping only: delivery method codes it waives; empty = every method.",
            "maxItems": 20
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "is_active": {
            "type": "boolean"
          },
          "automatic": {
            "type": "boolean"
          },
          "stackable": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer",
            "maximum": 1000,
            "minimum": -1000
          },
          "usage_limit_total": {
            "type": "integer",
            "maximum": 10000000,
            "minimum": 1,
            "nullable": true
          },
          "usage_limit_per_user": {
            "type": "integer",
            "maximum": 10000000,
            "minimum": 1,
            "nullable": true
          }
        }
      },
      "PromoCodeCreateRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stored upper-cased.",
            "maxLength": 64
          },
          "usage_limit": {
            "type": "integer",
            "maximum": 10000000,
            "minimum": 1,
            "nullable": true
          },
          "assigned_user_id": {
            "type": "string",
            "maxLength": 64
          },
          "is_active": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "code"
        ]
      },
      "PromoCodePage": {
        "type": "object",
        "description": "Anchor envelope of a promotion's codes (schema only).",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromoCodeResponse"
            }
          },
          "next_anchor": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "prev_anchor": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "has_next": {
            "type": "boolean"
          },
          "has_prev": {
            "type": "boolean"
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "count",
          "has_next",
          "has_prev",
          "items",
          "next_anchor",
          "prev_anchor"
        ]
      },
      "PromoCodeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "promotion_id": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "maxLength": 64
          },
          "is_active": {
            "type": "boolean"
          },
          "usage_limit": {
            "type": "integer",
            "nullable": true
          },
          "used": {
            "type": "integer",
            "minimum": 0,
            "description": "Committed uses."
          },
          "assigned_user_id": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "batch": {
            "type": "string",
            "nullable": true,
            "maxLength": 32
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Set when an issuer revoked the code; it never applies again."
          },
          "revoke_reason": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "assigned_user_id",
          "batch",
          "code",
          "created_at",
          "id",
          "is_active",
